# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: only for server-side share creation / admin (never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: NASA Open API key for DONKI solar feed (defaults to DEMO_KEY)
# Get free key: https://api.nasa.gov/
# NASA_API_KEY=your_nasa_key
